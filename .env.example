# Copy to a local shell or secret manager. Never commit real values.
OSIS_MODEL_API_KEY=<set-locally>
OSIS_MODEL_BASE_URL=http://gateway.example/v1
OSIS_PARENT_REPO=/absolute/path/to/osis-skill-enhance
# Optional when opencode is not on PATH:
OPENCODE_EXE=/absolute/path/to/opencode
# Optional native OSIS-AI instructions override:
OSIS_AGENTS_FILE=/absolute/path/to/AGENTS.md
